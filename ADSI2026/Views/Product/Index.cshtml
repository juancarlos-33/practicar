@{
}


<div class="row">
    <div class="col-md-8">
        <h1>Listado Productos </h1>
    </div>
    <div class="col-md-4">
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary float-end" onclick="openModal(false)">
            <i class="fa-solid fa-plus"></i>
            Crear Productos
        </button>
    </div>
</div>




<div class="row">
    <div class="col-md-12">
        <table class="table" id="tblProduct">
            <thead class="thead-dark">
                <tr>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Categoría</th>
                    <th>Proveedor</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>

        </table>
    </div>
</div>



<!-- Modal -->
<div class="modal fade" id="modalProduct" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="idTitleProduct">Crear</h1>
                <button type="button" class="btn-close" onclick="clearFormProduct()" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <form>
                    <section class="row">
                        <div class="col-md-6">
                            <label class="col-form-label">Producto</label>
                            <input type="text" class="form-control" id="txtProduct" maxlength="40" placeholder="Nombre Producto" />
                        </div>
                        <div class="col-md-3">
                            <label class="col-form-label">Precio</label>
                            <input type="number" class="form-control" id="txtPrice" min="0" step="0.01" placeholder="Precio" />
                        </div>
                        <div class="col-md-3">
                            <label class="col-form-label">Cantidad</label>
                            <input type="number" class="form-control" id="txtStock" min="0" step="1" placeholder="Cantidad" />
                        </div>
                    </section>

                    <section class="row">

                        <div class="col-md-6">
                            <label class="col-form-label">Categoría</label>
                            <select id="cmbCategory" class="form-control" onchange="changeCmbCategory()">
                                <option disabled selected>Seleccionar</option>
                            </select>

                        </div>
                        <div class="col-md-6">
                            <label class="col-form-label">Proveedor</label>
                            <select id="cmbSupplier" class="form-control" onchange="changeCmbSupplier()">
                                <option disabled selected>Seleccionar</option>
                            </select>
                        </div>
                    </section>
                </form>






            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" onclick="clearFormProduct()">Cancelar</button>
                <button id="btnModalSave" type="button" class="btn btn-outline-success" onclick="onSaveProduct()">Crear</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script type="text/javascript">

        var listCategory = [];
        var listSupplier = [];
        var listProduct = [];
        var idProductSelected = 0;

        $(document).ready(function () {
            getAllProducts();
            getAllSuppliers();
            getAllCatogories();
        });

        function getAllSuppliers() {
            $.ajax({
                url: '@Url.Action("GetAllSuppliers", "Supplier")',
                method: 'GET',
                dataType: 'json',
                success: function (result) {
                    listSupplier = result;
                    loadCmbSupplier(listSupplier);
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }

        function loadCmbSupplier(data, selected) {
            $("#cmbSupplier").empty();
            $("#cmbSupplier").append('<option value="" disabled selected>Seleccione un Proveedor</option>');
            $.each(data, function (i) {
                const isSelected = data[i].supplierId == selected ? ' selected' : '';
                $("#cmbSupplier").append('<option value="' + data[i].supplierId + '"' + isSelected + '>' + data[i].companyName + '</option>');
            });
        }

        function getAllCatogories() {
            $.ajax({
                url: '@Url.Action("GetAllCatogories", "Categories")',
                method: 'GET',
                dataType: 'json',
                success: function (result) {
                    listCategory = result;
                    loadCmbCategory(listCategory);
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }

        function loadCmbCategory(data, selected) {
            $("#cmbCategory").empty();
            $("#cmbCategory").append('<option value="" disabled selected>Seleccione una Categoría</option>');
            $.each(data, function (i) {
                const isSelected = data[i].categoryId == selected ? ' selected' : '';
                $("#cmbCategory").append('<option value="' + data[i].categoryId + '"' + isSelected + '>' + data[i].categoryName + '</option>');
            });
        }

        function changeCmbCategory() {
            console.log('categoria seleccionada: ', $('#cmbCategory').val());
        }

        function changeCmbSupplier() {
            console.log('proveedor seleccionado: ', $('#cmbSupplier').val());
        }

        function getAllProducts() {
            $.ajax({
                url: '@Url.Action("GetAllProducts", "Product")',
                method: 'GET',
                dataType: 'json',
                success: function (result) {
                    listProduct = result;
                    loadTable(listProduct);
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }

        function loadTable(data) {
            $('#tblProduct').DataTable({
                data: data,
                destroy: true,
                responsive: true,
                language: {
                    search: 'Buscar:',
                    lengthMenu: 'Mostrar _MENU_ registros por pagina',
                    info: 'Mostrando _START_ a _END_ de _TOTAL_ productos',
                    infoEmpty: 'No hay productos disponibles',
                    infoFiltered: '(filtrado de _MAX_ productos)',
                    zeroRecords: 'No se encontraron productos',
                    paginate: {
                        first: 'Primero',
                        last: 'Ultimo',
                        next: 'Siguiente',
                        previous: 'Anterior'
                    }
                },
                columns: [
                    { data: 'productName' },
                    { data: 'unitPrice' },
                    { data: 'unitsInStock' },
                    { data: 'category' },
                    { data: 'supplier' },
                    {
                        data: null,
                        render: function (data) {
                            const id = data.productId;
                            return `
                                <button class="btn btn-warning" onclick="editProduct('${id}')"><i class="fas fa-edit"></i> Editar</button>
                                <button class="btn btn-danger" onclick="deleteProduct('${id}')"><i class="far fa-trash-alt"></i> Eliminar</button>
                            `;
                        }
                    }
                ]
            });
        }

        function deleteProduct(id) {
            alertDelete().then((result) => {
                if (result.isConfirmed) {
                    confirmDeleteProduct(id);
                } else {
                    console.log('No eliminar', id);
                }
            });
        }

        function confirmDeleteProduct(id) {
            $.ajax({
                url: '@Url.Action("DeleteProduct", "Product")',
                method: 'DELETE',
                data: { id: id },
                dataType: 'json',
                success: function (result) {
                    console.log(result);
                    toastMessage('success', 'Registro eliminado exitosamente');
                    getAllProducts();
                },
                error: function (error) {
                    console.error(error);
                    alertError('Ha ocurrido un error, por favor vuelva a intentarlo');
                }
            });
        }

        function clearFormProduct() {
            $('#txtProduct').val('');
            $('#txtPrice').val('');
            $('#txtStock').val('');
            loadCmbCategory(listCategory);
            loadCmbSupplier(listSupplier);
            $('#modalProduct').modal('hide');
            idProductSelected = 0;
        }

        function validateForm() {
            if ($('#txtProduct').val() == '') {
                $('#txtProduct').focus();
                toastMessage('warning', 'El producto es obligatorio.');
                return false;
            }

            if ($('#txtPrice').val() == '') {
                $('#txtPrice').focus();
                toastMessage('warning', 'El precio es obligatorio.');
                return false;
            }

            if (Number($('#txtPrice').val()) < 0) {
                $('#txtPrice').focus();
                toastMessage('warning', 'El precio no puede ser negativo.');
                return false;
            }

            if ($('#txtStock').val() == '') {
                $('#txtStock').focus();
                toastMessage('warning', 'La cantidad es obligatoria.');
                return false;
            }

            if (Number($('#txtStock').val()) < 0) {
                $('#txtStock').focus();
                toastMessage('warning', 'La cantidad no puede ser negativa.');
                return false;
            }

            if (!$('#cmbCategory').val()) {
                $('#cmbCategory').focus();
                toastMessage('warning', 'La categoría es obligatoria.');
                return false;
            }

            if (!$('#cmbSupplier').val()) {
                $('#cmbSupplier').focus();
                toastMessage('warning', 'El proveedor es obligatorio.');
                return false;
            }

            return true;
        }

        function openModal(isEdit) {
            if (isEdit) {
                $('#idTitleProduct').html('Editar producto');
                $('#btnModalSave').html('Editar');
            } else {
                clearFormProduct();
                $('#idTitleProduct').html('Crear producto');
                $('#btnModalSave').html('Crear');
                $('#modalProduct').modal('show');
            }
        }

        function onSaveProduct() {
            if (validateForm()) {
                const entity = {
                    productName: $('#txtProduct').val(),
                    unitPrice: $('#txtPrice').val(),
                    unitsInStock: $('#txtStock').val(),
                    categoryId: $('#cmbCategory').val(),
                    supplierId: $('#cmbSupplier').val()
                };

                if (idProductSelected == 0) {
                    addProduct(entity);
                } else {
                    entity.productId = idProductSelected;
                    confirmEditProduct(entity);
                }
            }
        }

        function addProduct(parameter) {
            $.ajax({
                url: '@Url.Action("AddProduct", "Product")',
                method: 'POST',
                data: parameter,
                dataType: 'json',
                success: function (result) {
                    console.log(result);
                    toastMessage('success', 'Registro creado exitosamente');
                    clearFormProduct();
                    getAllProducts();
                },
                error: function (error) {
                    console.error(error);
                    alertError('Ha ocurrido un error, por favor vuelva a intentarlo');
                }
            });
        }

        function editProduct(id) {
            idProductSelected = id;
            const entity = listProduct.find(x => x.productId == idProductSelected);

            $('#txtProduct').val(entity.productName);
            $('#txtPrice').val(entity.unitPrice);
            $('#txtStock').val(entity.unitsInStock);
            loadCmbCategory(listCategory, entity.categoryId);
            loadCmbSupplier(listSupplier, entity.supplierId);

            openModal(true);
            $('#modalProduct').modal('show');
        }

        function confirmEditProduct(parameter) {
            $.ajax({
                url: '@Url.Action("UpdateProduct", "Product")',
                method: 'PUT',
                data: parameter,
                dataType: 'json',
                success: function (result) {
                    console.log(result);
                    toastMessage('success', 'Registro actualizado exitosamente');
                    clearFormProduct();
                    getAllProducts();
                },
                error: function (error) {
                    console.error(error);
                    alertError('Ha ocurrido un error, por favor vuelva a intentarlo');
                }
            });
        }

    </script>
}
